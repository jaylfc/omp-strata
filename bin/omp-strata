#!/bin/bash
# omp-strata runs upstream omp with this profile.
# `omp` itself stays the stock command and its own ~/.omp/agent.
# `omp-strata update` pulls https://github.com/jaylfc/omp-strata.
set -euo pipefail

source="$(readlink -f "$0")"
root="$(cd "$(dirname "$source")/.." && pwd)"

if [[ "${1:-}" == "update" ]]; then
  exec "$root/scripts/self-update.sh"
fi

# ~/.config/omp-strata/omp-path may name the omp binary to run (one line). It lets a machine move to a
# newer omp, or roll back, without touching the host mount.
override="${XDG_CONFIG_HOME:-$HOME/.config}/omp-strata/omp-path"
if [[ -f "$override" && -r "$override" ]]; then
  bin="$(head -n1 "$override")"
  if [[ -x "$bin" ]]; then
    exec "$bin" --profile=omp-strata "$@"
  fi
  echo "omp-strata: $override names $bin, which is not executable; using the default omp" >&2
fi

if [[ -x /opt/host-omp/omp ]]; then
  exec /opt/host-omp/omp --profile=omp-strata "$@"
fi
exec omp --profile=omp-strata "$@"
